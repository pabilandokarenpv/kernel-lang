struct Point:
    x: int
    y: int

fn peek(p: &Point):
    print(p.x)

fn take(p: Point):
    print(p.x)

fn main():
    let origin = Point(x: 1, y: 2)
    let flag = 1
    if flag == 1:
        peek(&origin)      # borrow only, both arms
    else:
        peek(&origin)
    take(origin)            # fine: origin was never moved in either arm
