enum Color:
    Red
    Green
    Blue

fn describe_num(n: int) -> str:
    match n:
        0:
            return "zero"
        1:
            return "one"
        2:
            return "two"
        _:
            return "many"

fn describe_color(c: int) -> str:
    match c:
        Red:
            return "stop"
        Green:
            return "go"
        _:
            return "caution"

fn describe_flag(b: bool) -> str:
    match b:
        true:
            return "yes"
        false:
            return "no"

fn main():
    print(describe_num(0))
    print(describe_num(2))
    print(describe_num(99))

    print(describe_color(Red))
    print(describe_color(Green))
    print(describe_color(Blue))

    print(describe_flag(true))
    print(describe_flag(false))
