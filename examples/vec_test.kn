fn main():
    let mut v: Vec<int> = vec_new()
    vec_push(&mut v, 10)
    vec_push(&mut v, 20)
    vec_push(&mut v, 30)
    print(vec_len(v))
    print(vec_get(v, 0))
    print(vec_get(v, 1))
    print(vec_get(v, 2))
    vec_set(&mut v, 1, 99)
    print(vec_get(v, 1))
    vec_push(&mut v, 40)
    print(vec_len(v))
    print(vec_get(v, 3))
